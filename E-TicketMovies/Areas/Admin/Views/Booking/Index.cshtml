@model IEnumerable<Booking>
<div class="container-fluid">

    <!-- Title & Create Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">All Bookings</h1>
        <a href="/End%20User/Home/index" class="btn btn-primary btn-icon-split">
            <span class="icon text-white-50">
                <i class="fas fa-plus"></i>
            </span>
            <span class="text">Add New</span>
        </a>
    </div>

    <!-- Bookings Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
           
            <a href="/Admin/Booking/Index" class="btn btn-primary btn-icon-split">

                <h6 class="text">All Booking List</h6>
            </a>
            <a href="/Admin/Booking/Index?refunded=true" class="btn btn-primary btn-icon-split">

                <h6 class="text">Refunded Booking</h6>
            </a>

            <a href="/Admin/Booking/Index?cancelled=true" class="btn btn-primary btn-icon-split">

                <h6 class="text">Canceled Booking</h6>
            </a>
            <a href="/Admin/Booking/Index?booked=true" class="btn btn-primary btn-icon-split">

                <h6 class="text">Completed Booking</h6>
            </a>

            <form method="get" action="/Admin/Booking/Index" class="form-inline">
                <div class="input-group">
                    <input type="text" class="form-control bg-light small" name="query" placeholder="Search for..."
                    aria-label="Search" aria-describedby="basic-addon2" style="border: 2px solid #fff;">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search fa-sm"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>User </th>
                            <th>Email</th>
                            <th>Booking Time</th>
                            <th>Status</th>
                            <th>Payment Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ApplicationUser.UserName</td>
                                <td>@item.ApplicationUser.Email</td>
                                <td> @item.BookingTime</td>
                                <td>
                                    @if (item.Status && item.PaymentStatus)
                                    {
                                        @:Booked
                                    }
                                    else if (!item.Status && item.PaymentStatus)
                                    {
                                        @:Refund Pending
                                    }
                                    else if (!item.Status && !item.PaymentStatus)
                                    {
                                        @:Refund
                                    }
                                </td>
                                <td>
                                    @if (item.PaymentStatus)
                                    {
                                        @:Paid
                                    }
                                    else
                                    {
                                        @:Refunded
                                    }
                                </td>

                                <td>
                                      <a href="/Admin/Booking/ShowDetails/@item.Id" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Show Booking
                                        </a>
                                    @if (item.Status)
                                    {
                                        <button class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id)" disabled>
                                            <i class="fas fa-trash"></i> Refund
                                        </button>
                                    }
                                    else if (!item.Status && item.PaymentStatus)
                                    {
                                        <button class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id)">
                                            <i class="fas fa-trash"></i> Refund
                                        </button>
                                    }
                                    else {
                                        <button class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id)" disabled>
                                            <i class="fas fa-trash"></i> Refund
                                        </button>
                                    }
                                    </td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-end">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 0; i < ViewBag.totalPages; i++)
                    {
                            <li class="page-item"><a class="page-link" href="/Admin/Booking/Index?page=@(i+1)">@(i + 1)</a></li>
                    }
                    <a class="page-link" href="">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

</div>

<!-- Include SweetAlert2 -->
<script>
    function confirmDelete(bookingId) {
        Swal.fire({
            title: "Are you sure?",
            text: "This action cannot be undone!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#143D60",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, Refund It!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Admin/Booking/Refund/" + bookingId;
            }
        });
    }
</script>
