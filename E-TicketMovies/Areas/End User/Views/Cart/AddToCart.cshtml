@{
    int cartNum = Convert.ToInt32(ViewBag.Count ?? 0);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/end user/style.css">

    <style>
        .cart-wrapper {
        background-color: #f8f9fa;
        min-height: 100vh;
        padding: 40px 0;
        }

        .product-card {
        background: white;
        border-radius: 12px;
        transition: transform 0.2s;
        }

        .product-card:hover {
        transform: translateY(-2px);
        }

        .quantity-input {
        width: 60px;
        text-align: center;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        }

        .product-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        }

        .summary-card {
        background: white;
        border-radius: 12px;
        position: sticky;
        top: 20px;
        }

        .checkout-btn {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        transition: transform 0.2s;
        }

        .checkout-btn:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        }

        .remove-btn {
        color: #dc2626;
        cursor: pointer;
        transition: all 0.2s;
        }

        .remove-btn:hover {
        color: #991b1b;
        }

        .quantity-btn {
        width: 28px;
        height: 28px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #f3f4f6;
        border: none;
        transition: all 0.2s;
        }

        .quantity-btn:hover {
        background: #e5e7eb;
        }

        .discount-badge {
        background: #dcfce7;
        color: #166534;
        font-size: 0.875rem;
        padding: 4px 8px;
        border-radius: 6px;
        }
    </style>
</head>
<body>

    <header>


        <nav class="navbar">
            <div class="navbar-left">
                <img src="~/logo.png" alt="E-Tick Logo">
                <div class="navbar-links">
                    <a href="/End%20User/Home">E-Tick</a>
                    <a href="/End%20User/Home">Home</a>
                    <a href="/End%20User/Home/ShowCinema">Cinema</a>
                    <a href="/End%20User/Booking/Index">My Booking</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <a href="/Admin/Home/Index">Managment System</a>
                    }
                </div>
            </div>

            <div class="navbar-right">
                <a href="/End%20User/Cart/AddToCart">
                    <i class="bi bi-cart" style="color:aliceblue"></i>

                    <span class='badge badge-warning' id='lblCartCount'>@cartNum</span>
                </a>


                @if (User.Identity.IsAuthenticated)
                {
                    <a href="#">Welcom @User.Identity.Name </a>
                    <a href="/Identity/Account/Logout">Logut</a>
                }
                else
                {
                    <a href="/Identity/Account/Login">Login</a>
                    <a href="/Identity/Account/Register">Register</a>
                }





            </div>
        </nav>


    </header>

    @model IEnumerable<Cart>
    <div class="cart-wrapper">
        <div class="container">
            <div class="row g-4">
                <!-- Cart Items Section -->
                <div class="col-lg-8">
                  

                    <!-- Product Cards -->
                    <div class="d-flex flex-column gap-3">
                        <!-- Product 1 -->
                        @foreach(var item in Model)
                        {
                            <div class="product-card p-3 shadow-sm">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <img src="~/images/movies/@item.Movie.ImgUrl" alt="Product" class="product-image">
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="mb-1">@item.Movie.Name</h6>
                                        <p class="text-muted mb-0">Cinema | @item.Movie.Cinema.Name</p>

                                    </div>
                                    <div class="col-md-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <form method="post" action="/End%20User/Cart/Decrement/@item.MovieId">
                                                <input type="hidden" name="movieId" value="@item.MovieId">
                                                <button type="submit" class="quantity-btn">-</button>
                                            </form>

                                            <input type="number" class="quantity-input" name="count" value="@item.Count" min="1" readonly>

                                            <form method="post" action="/End%20User/Cart/Increment/@item.MovieId">
                                                <input type="hidden" name="movieId" value="@item.MovieId">
                                                <button type="submit" class="quantity-btn">+</button>
                                            </form>
                                        </div>
                                    </div>

                                 
                              
                                    <div class="col-md-2">
                                        <span class="fw-bold">@item.Movie.Price.ToString("C")</span>
                                    </div>
                                    <div class="col-md-1">
                                        <form method="post" action="/End%20User/Cart/Delete/@item.MovieId">
                                            <input type="hidden" name="movieId" value="@item.MovieId">
                                            <button type="submit" class="bi bi-trash remove-btn" style="border: none; background: none;"></button>
                                        </form>
                                    </div>

                                </div>
                            </div>

                        }





                    </div>
                </div>

                <!-- Summary Section -->
                <div class="col-lg-4">
                    <div class="summary-card p-4 shadow-sm">
                        <h5 class="mb-4">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal</span>
                           
                            <span>@ViewBag.TotalPrie.ToString("C")</span>
                            
                        </div>
                      
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold">Total</span>
                            <span class="fw-bold">@ViewBag.TotalPrie.ToString("C")</span>
                        </div>

                        <!-- Promo Code -->
                        <div class="mb-4">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Promo code">
                                <button class="btn btn-outline-secondary" type="button">Apply</button>
                            </div>
                        </div>

                        <a href="/End%20User/Cart/Checkout" class="btn btn-primary checkout-btn w-100 mb-3">
                            Proceed to Checkout
                        </a>

                        <div class="d-flex justify-content-center gap-2">
                            <i class="bi bi-shield-check text-success"></i>
                            <small class="text-muted">Secure checkout</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
</body>
</html>