@model IEnumerable<Movie>

<div class="toto noCarousel">
    <ul id="thumb-carousel">
        @foreach (var item in Model)
        {
            <li><img src="~/images/movies/@item.ImgUrl" alt="Movie 1" class="outdoorShadow" /></li>
        }
        
    </ul>
</div>

<!-- Filter Section -->
<section class="py-4 bg-light" style="background-color: #233142!important; margin-top: 20px; padding: 30px 0; box-shadow: 0 2px 5px rgb(130, 123, 123)">
    <div class="container px-4 px-lg-5">
        <form>
            <div class="row">
                <!-- Category Filter -->
                <div class="col-md-3">
                    <select name="categoryName" class="form-select">
                        <option>All Categories</option>
                        @foreach (var item in ViewBag.categories)
                        {
                        <option value="@item.Name">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="cinemaName" class="form-select">
                        <option>Cinema</option>
                        @foreach (var item in ViewBag.Cinemas)
                        {
                        <option value="@item.Name">@item.Name</option>
                        }
                    </select>
                </div>

                <!-- Search by Name -->
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Search by name" name="movieName" />
                </div>

               
                <br />
                <!-- Submit Button -->
                <div class="col-md-3 ">
                    <button type="submit" class="btn btn-dark w-50">Search</button>
                </div>
            </div>
        </form>
    </div>
</section>
<section id="movies" class="container py-5">
@*     <h1 style="color: #233142;" class="text-center mb-4">All Movies</h1> *@

    <div class="row">
       
        @foreach (var item in Model)
        {
           
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="movie-card">
                    <img src="~/images/movies/@item.ImgUrl" alt="Movie Poster">
                    <div class="movie-info text-center">
                        <h3>@item.Name</h3>

                        @if (item.MovieStatus == 0)
                        {
                            <p><button type="button" class="btn btn-info">Coming Soon</button></p>
                            <button type="button" class="btn btn-dark" disabled>Book Ticket</button>
                        }
                        else if (item.MovieStatus == 1)
                        {
                            <p><button type="button" class="btn btn-success">Available</button></p>
                            <form action="/End%20User/Home/BookTicket" method="post">
                                <input type="text" name="movieId" value="@item.Id" style="display:none"/>
                                <button   class="btn btn-dark">Book Ticket</button>
                            </form>
                            
                        }
                        else
                        {
                            <p><button type="button" class="btn btn-danger">Expired</button></p>
                            <button type="button" class="btn btn-dark" disabled>Book Ticket</button>
                        }

                        <a href="/End%20User/Home/ShowDetails/@item.Id" class="btn btn-light mt-2">More Details</a>
                    </div>
                </div>
            </div>
            
        }
    </div>
</section>
