@model IEnumerable<BookingItem>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <!--  All snippets are MIT license http://bootdey.com/license -->
    <title>order details - Bootdey.com</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

      <link rel="stylesheet" href="~/end user/style.css">

    <style type="text/css">
        body{
    background:#eee;
}
.card {
    box-shadow: 0 20px 27px 0 rgb(0 0 0 / 5%);
}
.card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    word-wrap: break-word;
    background-color: #fff;
    background-clip: border-box;
    border: 0 solid rgba(0,0,0,.125);
    border-radius: 1rem;
}
.text-reset {
    --bs-text-opacity: 1;
    color: inherit!important;
}
a {
    color: #5465ff;
    text-decoration: none;
}
    </style>
</head>
<body>

    <header>


        <nav class="navbar">
            <div class="navbar-left">
                <img src="~/logo.png" alt="E-Tick Logo">
                <div class="navbar-links">
                    <a href="/End%20User/Home">E-Tick</a>
                    <a href="/End%20User/Home">Home</a>
                    <a href="#">Events</a>
                    <a href="#">Contact</a>
                    <a href="/End%20User/Booking/Index">My Booking</a>

                </div>
            </div>

            <div class="navbar-right">
                <a href="/End%20User/Cart/AddToCart">
                    <i class="bi bi-cart" style="color:aliceblue"></i>

                    <span class='badge badge-warning' id='lblCartCount'>3</span>
                </a>


                @if (User.Identity.IsAuthenticated)
                {
                        <a href="#">Welcom @User.Identity.Name </a>
                        <a href="/Identity/Account/Logout">Logut</a>
                }
                else
                {
                        <a href="/Identity/Account/Login">Login</a>
                        <a href="/Identity/Account/Register">Register</a>
                }


            </div>
        </nav>


    </header>

    <div class="container-fluid">

<div class="container">
  <!-- Title -->
  <div class="d-flex justify-content-between align-items-center py-3">
                <h2 class="h5 mb-0"><a href="#" class="text-muted"></a>  </h2>
            </div>

  <!-- Main content -->
  <div class="row">
    <div class="col-lg-8">
      <!-- Details -->
      <div class="card mb-4">
        <div class="card-body">
          <div class="mb-3 d-flex justify-content-between">
            <div>
           
               <span class="me-3">Booking No: @ViewBag.Id</span>
              <span class="me-3">@ViewBag.Date</span> 
              <span class="me-3">Visa -1234</span>
                                    <span class="badge rounded-pill bg-info">
                                        @((ViewBag.Status) ? "Booked" : "Canceled")
                                       
                                    </span>
                                </div>
            <div class="d-flex">
           
            </div>
          </div>
          <table class="table table-borderless">
            <tbody>
                @foreach(var item in Model){
              <tr>
                <td>
                  <div class="d-flex mb-2">
                    <div class="flex-shrink-0">
                      <img src="~/images/movies/@item.Movie.ImgUrl" alt="" width="35" class="img-fluid">
                    </div>
                    <div class="flex-lg-grow-1 ms-3">
                      <h6 class="small mb-0"><a href="#" class="text-reset">@item.Movie.Name</a></h6>
                      <span class="small">Cinema: @item.Movie.Cinema.Name</span>
                    </div>
                  </div>
                </td>
                <td>@item.Count</td>
                <td class="text-end">@item.Movie.Price</td>
              </tr>
              }
            </tbody>
            <tfoot>
              
              <tr class="fw-bold">
                <td colspan="2">TOTAL</td>
                <td class="text-end">@ViewBag.Total</td>
              </tr>
              
            </tfoot>
          </table>
        </div>
      </div>
      <!-- Payment -->
    @*   <div class="card mb-4">
        <div class="card-body">
          <div class="row">
            <div class="col-lg-6">
              <h3 class="h6">Payment Method</h3>
              <p>Visa -1234 <br>
                                        Total: @ViewBag.Total <span class="badge bg-success rounded-pill">PAID</span>
                                    </p>
                                </div>
            <div class="col-lg-6">
              <h3 class="h6">Billing address</h3>
              <address>
                <strong>@ViewBag.User.UserName</strong><br>
                                        @ViewBag.User.Email <br>
                                        <br>
              </address>
            </div>
          </div>
        </div>
      </div> *@
    </div>
    <div class="col-lg-4">

    </div>
  </div>
</div>
  </div>
<script src="https://code.jquery.com/jquery-1.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="text/javascript">

</script>
</body>
</html>