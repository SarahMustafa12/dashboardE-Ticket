    <div class="container mt-5">
        <h2 class="mb-4">My Bookings</h2>

        <table class="table">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">Booking No</th>
                    <th scope="col">Booking Time</th>
                    <th scope="col">Status</th>
                    <th scope="col">Payment Status</th>
                    <th scope="col">Total Price</th>
                    <th scope="col">Action</th>


                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model){
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.BookingTime</td>
                        <td>
                            @if (item.Status && item.PaymentStatus)
                            {
                                @:Booked
                            }
                            else if (!item.Status && item.PaymentStatus)
                            {
                                @:Refund Pending
                            }
                            else if (!item.Status && !item.PaymentStatus)
                            {
                                @:Refunded
                            }

                        </td>
                        <td>
                            @if (item.PaymentStatus)
                            {
                                @:Paid
                            }
                            else
                            {
                                @:Refunded
                            }
                        </td>
                        <td>@item.TotalPrice</td>
                        <td>
                            <a href="/End%20User/Booking/BookingDetalis/@item.Id" class="btn btn-info">Show Detalis</a>
                            @if (item.Status)
                            {
                                <a href="/End%20User/Booking/Canceled/@item.Id" class="btn btn-dark">Refund</a>

                            }
                            else
                            {
                                <button href="/End%20User/Booking/Canceled/@item.Id" class="btn btn-dark" disabled  >Refund</button>

                            }
                        </td>
                </tr>
                }
            </tbody>
        </table>


    </div>

