<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Refund Request - E-Ticket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/end user/style.css">

    <style>
        body {
            background-color: #f8f9fa;
        }
        .refund-container {
            max-width: 400px;
            margin: 50px auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .btn-primary {
            --bs-btn-bg: #233142!important;
            
        }
    </style>
</head>
<body>
    <header>


        <nav class="navbar">
            <div class="navbar-left">
                <img src="~/logo.png" alt="E-Tick Logo">
                <div class="navbar-links">
                    <a href="/End%20User/Home">E-Tick</a>
                    <a href="/End%20User/Home">Home</a>
                    <a href="#">Events</a>
                    <a href="#">Contact</a>
                    <a href="/End%20User/Booking/Index">My Booking</a>

                </div>
            </div>

            <div class="navbar-right">
                <a href="/End%20User/Cart/AddToCart">
                    <i class="bi bi-cart" style="color:aliceblue"></i>

                    <span class='badge badge-warning' id='lblCartCount'>3</span>
                </a>


                @if (User.Identity.IsAuthenticated)
                {
                    <a href="#">Welcom @User.Identity.Name </a>
                    <a href="/Identity/Account/Logout">Logut</a>
                }
                else
                {
                    <a href="/Identity/Account/Login">Login</a>
                    <a href="/Identity/Account/Register">Register</a>
                }





            </div>
        </nav>


    </header>

<div class="container">
    <div class="refund-container">
        <h4 class="text-center mb-3">Refund Request</h4>
        <form>
            <div class="mb-3">
                <label for="orderId" class="form-label">Order ID</label>
                <input type="text" class="form-control" id="orderId" placeholder="Enter your order ID">
            </div>

            <div class="mb-3">
                <label for="reason" class="form-label">Refund Reason</label>
                <select class="form-select" id="reason">
                    <option value="wrong">Wrong Ticket</option>
                    <option value="cancelled">Event Cancelled</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Submit Request</button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
