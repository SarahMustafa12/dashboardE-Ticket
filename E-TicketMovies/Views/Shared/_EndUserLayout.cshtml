

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Ticket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/end user/style.css">
</head>
<body>
    <header>


        <nav class="navbar">
            <div class="navbar-left">
                <img src="~/logo.png" alt="E-Tick Logo">
                <div class="navbar-links">
                    <a href="/End%20User/Home">E-Tick</a>
                    <a href="/End%20User/Home">Home</a>
                    <a href="/End%20User/Home/ShowCinema">Cinema</a>
                    <a href="/End%20User/Booking/Index">My Booking</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <a href="/Admin/Home/Index">Managment System</a>
                    }
                </div>
            </div>

            <div class="navbar-right">
                <a href="/End%20User/Cart/AddToCart">
                    <i  class="bi bi-cart" style="color:aliceblue"></i>
                    
                    <span  class='badge badge-warning' id='lblCartCount'>0</span>
                </a>
                

               @if(User.Identity.IsAuthenticated)
               {
                    <a href="#" >Welcom @User.Identity.Name </a>
                    <a href="/Identity/Account/Logout" >Logut</a>
               }
               else {
                    <a href="/Identity/Account/Login" >Login</a>
                    <a href="/Identity/Account/Register" >Register</a>
               }
             
            </div>
        </nav>


    </header>
 



    @RenderBody()

    <!-- Footer-->
    <footer class="py-5 " style="background-color:#233142">
        <div class="container"><p class="m-0 text-center text-white">Copyright &copy; Your Website 2023</p></div>
    </footer>
   
 

    <!-- Load jQuery (only once, and first) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Then Bootstrap JS (which requires jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your own site/app scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="@Url.Content("~/end user/app.js")"></script>
    <script src="~/end user/test.js"></script>

    <!-- Optional Razor section -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>




